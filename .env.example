# Neon Postgres connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/phoneshare?sslmode=require"

# 32+ karakterlik rastgele secret (JWT HS256 imzalama).
#
# ONEMLI: Bu deger local agent (apps/agent) ile PAYLASILIR. Cihaz access token'lari
# control plane tarafinda bu secret ile imzalanir ve agent tarafinda AYNI secret ile
# dogrulanir. Iki taraf farkli olursa agent tum istekleri 401 ile reddeder.
#
# Uretme:
#   openssl rand -base64 48
#   veya: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#   veya: python -c "import secrets;print(secrets.token_urlsafe(48))"
#
# Agent tarafinda config.json'a YAZILMAZ; ortam degiskeni olarak verilir:
#   setx AUTH_SECRET "<ayni-deger>"   (Windows, yeni terminal gerekir)
#   export AUTH_SECRET="<ayni-deger>" (POSIX)
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Uygulamanin public URL'i (CSRF origin kontrolu ve QR payload icin kullanilir)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
