{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhoneShare",
  "version": "1.0.0",
  "identifier": "com.palamut62.phoneshare",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5178",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PhoneShare",
        "label": "main",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://127.0.0.1:* https://localhost:*"
    },
    "trayIcon": {
      "id": "phoneshare-tray",
      "iconPath": "icons/tray-offline.png",
      "iconAsTemplate": false,
      "tooltip": "PhoneShare"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Umut Celik (palamut62)",
    "copyright": "Umut Celik (palamut62)",
    "category": "Utility",
    "shortDescription": "iPhone'dan Windows'a dosya aktarimi",
    "longDescription": "PhoneShare — iPhone'dan Windows klasorlerine guvenli, dogrulanmis dosya aktarimi. Receiver (FastAPI) sidecar olarak calisir.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../web/out": "web",
      "../../../receiver/dist/phoneshare-receiver": "receiver"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["turkish", "english"]
      }
    }
  }
}
